# Shared core: installed on every machine, work or personal.
# Machine-specific additions live in Brewfile.personal and Brewfile.work,
# picked by install.sh from ~/.dotfiles.profile.

# Taps
tap 'homebrew/bundle'

# Binaries
brew 'bash'
brew 'bat'
brew 'coreutils'
brew 'ffmpeg'
brew 'gh'
brew 'git'
brew 'grep'
brew 'jq'
brew 'mas'
brew 'gnupg'
# GPG needs a pinentry to prompt for a passphrase; without it signing fails in
# a way that looks like a key problem. Was installed by hand on this machine.
brew 'pinentry-mac'
brew 'composer'
brew 'nvm'

# Languages
brew 'pipx'
brew 'php'
# zsh/path.zsh puts this on PATH and derives GEM_HOME from it.
brew 'ruby'

# Terminal
brew 'pure'
brew 'zsh-autosuggestions'
brew 'zsh-syntax-highlighting'

# Development
brew 'imagemagick'

# Dev
cask 'dbngin'
cask 'docker-desktop'
cask 'figma'
cask 'github'
cask 'phpstorm'
cask 'sublime-text'
cask 'yaak'
cask 'font-ubuntu-mono'
brew 'mailpit'

# Utils
cask '1password'
cask '1password-cli'
cask 'caffeine'
cask 'httpie-desktop'
cask 'imageoptim'

# Media
cask 'iina'
cask 'spotify'
cask 'plexamp'

# Communication
cask 'discord'

# Quicklook
cask 'qlmarkdown'
cask 'quicklook-json'
