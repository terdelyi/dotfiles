# Shared core: installed on every machine, work or personal.
# Machine-specific additions live in Brewfile.personal and Brewfile.work,
# picked by install.sh from ~/.dotfiles.profile.
#
# Nothing here can be excluded from one profile: a Brewfile has no "skip this
# one" form. Anything that should not land on the work machine belongs in
# Brewfile.personal instead.

# Binaries
brew 'ansible'
brew 'bash'
brew 'bat'
brew 'coreutils'
brew 'ffmpeg'
brew 'gh'
brew 'git'
brew 'grep'
brew 'jq'
brew 'mas'
brew 'gnupg'
# GPG needs a pinentry to prompt for a passphrase; without it signing fails in
# a way that looks like a key problem. Was installed by hand on this machine.
brew 'pinentry-mac'
brew 'composer'
brew 'nvm'
brew 'pigz'
brew 'pkgconf'
brew 'pv'

# Languages
brew 'pipx'
brew 'php'
# Homebrew's Ruby rather than the system one, which is old and unwritable.
# zsh/path.zsh puts this on PATH and derives GEM_HOME from it.
brew 'ruby'

# Terminal
brew 'pure'
brew 'zsh-autosuggestions'
brew 'zsh-syntax-highlighting'

# Development
brew 'imagemagick'
brew 'ollama'
brew 'redis'
brew 'xcodegen'

