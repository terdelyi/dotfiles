# Identity lives in ~/.gitconfig.local, which is not tracked here. install.sh
# seeds it. Keeping [user] out of the repo makes room for per-directory
# identities via includeIf without touching the shared config.
[include]
    path = ~/.gitconfig.local

[core]
    excludesfile = ~/.gitignore_global
    autocrlf = input

[color]
    ui = auto

[init]
    defaultBranch = main

[pull]
    # Merge commits from a plain `git pull` are noise; replay local work instead.
    rebase = true

[fetch]
    # What the `prune` alias in zsh/aliases.zsh did by hand.
    prune = true
    pruneTags = true

[rerere]
    # Remember how a conflict was resolved and reapply it the next time the
    # same one shows up - which a rebase-by-default workflow makes likely.
    enabled = true
    autoUpdate = true

[diff]
    # Colour moved lines differently from added and removed ones, so a large
    # refactor reads as a move rather than a rewrite.
    colorMoved = zebra

[github]
    user = terdelyi

[commit]
    gpgSign = true

[tag]
    gpgsign = true

[gpg "ssh"]
    program = /Applications/1Password.app/Contents/MacOS/op-ssh-sign
    # Who git trusts when verifying a signature. The path is the same on every
    # machine, so it lives here; install.sh fills the file from the identity in
    # ~/.gitconfig.local. Without it, signing still works but `git log
    # --show-signature` cannot check anything.
    allowedSignersFile = ~/.ssh/allowed_signers

[gpg]
    format = ssh
